# Explicit demo mode; deterministic fixtures, NOT Jev/LLM output.
# Change to live after configuring the credentials below.
APP_MODE=mock
HOST=127.0.0.1
PORT=3000
WORLD_DB=data/world.sqlite
WORLD_EPOCH=mvp-1

JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
JEV_API_KEY=

# Base URL, NOT the full /chat/completions URL.
OPENAI_BASE_URL=https://api.deepseek.com/v1
# Verify the model ID available at your chosen endpoint.
OPENAI_MODEL=deepseek-flash
OPENAI_API_KEY=
# json_object | json_schema | off. All modes still use local Zod validation.
OPENAI_JSON_MODE=json_object
# omit for generic providers; disabled is a DeepSeek-specific extension.
OPENAI_THINKING=disabled
OPENAI_MAX_TOKENS=4096
REQUEST_TIMEOUT_MS=120000
