{
  "name": "jev-agentworld-web-simulator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "node scripts/verify-json-render.mjs && node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "dev": "npm run build && node --watch --env-file-if-exists=.env --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:live": "node --env-file-if-exists=.env --import tsx scripts/live.ts",
    "verify:json-render": "node scripts/verify-json-render.mjs"
  },
  "dependencies": {
    "@json-render/core": "file:vendor/json-render-core-3ad38188.tgz",
    "@json-render/react": "0.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.0",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
